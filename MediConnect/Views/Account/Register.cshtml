@model MediConnect.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="row justify-content-center my-4">
    <div class="col-md-7 col-lg-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4 p-md-5">

                <!-- Header -->
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle p-3 mb-2">
                        <i class="bi bi-person-plus-fill fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Join MediConnect</h3>
                    <p class="text-muted small">Select your role and enter your details to create an account.</p>
                </div>

                <!-- Registration Form -->
                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <!-- Role Selection -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">I AM REGISTERING AS A:</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="radio" class="btn-check" asp-for="Role" value="Patient" id="rolePatient" checked onchange="toggleDoctorFields()">
                                <label class="btn btn-outline-primary w-100 py-2 fw-semibold" for="rolePatient">
                                    <i class="bi bi-person me-1"></i> Patient
                                </label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check" asp-for="Role" value="Doctor" id="roleDoctor" onchange="toggleDoctorFields()">
                                <label class="btn btn-outline-primary w-100 py-2 fw-semibold" for="roleDoctor">
                                    <i class="bi bi-hospital me-1"></i> Doctor
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Full Name -->
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Passwords -->
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label small fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label small fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-shield-lock"></i></span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Doctor-Only Fields -->
                    <div id="doctorFields" class="d-none border-top pt-3 mt-3">
                        <div class="alert alert-info py-2 small d-flex align-items-center">
                            <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                            <span>Doctor profiles require administrator verification before activation.</span>
                        </div>

                        <!-- Specialization Dropdown -->
                        <div class="mb-3">
                            <label asp-for="Specialization" class="form-label small fw-semibold"></label>
                            <select asp-for="Specialization" id="specializationSelect" class="form-select" onchange="toggleOtherSpecialization()">
                                <option value="">Select Specialization...</option>
                                <option value="General Practice">General Practitioner</option>
                                <option value="Cardiology">Cardiologist</option>
                                <option value="Dermatology">Dermatologist</option>
                                <option value="Pediatrics">Pediatrician</option>
                                <option value="Orthopedics">Orthopedic Surgeon</option>
                                <option value="Neurology">Neurologist</option>
                                <option value="Psychiatry">Psychiatrist</option>
                                <option value="Other">Other (Please specify)</option>
                            </select>
                            <span asp-validation-for="Specialization" class="text-danger small"></span>
                        </div>

                        <!-- Custom Specialization Input (Only shown if "Other" is chosen) -->
                        <div id="otherSpecDiv" class="mb-3 d-none">
                            <label asp-for="OtherSpecialization" class="form-label small fw-semibold text-primary">
                                <i class="bi bi-pencil me-1"></i>Please specify your specialization:
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-clipboard2-plus"></i></span>
                                <input asp-for="OtherSpecialization" id="otherSpecInput" class="form-control" placeholder="e.g. Oncologist, Radiologist, ENT Specialist" />
                            </div>
                            <span asp-validation-for="OtherSpecialization" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LicenseNumber" class="form-label small fw-semibold">Medical License / Practice Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-patch-check"></i></span>
                                <input asp-for="LicenseNumber" class="form-control" placeholder="e.g. MP-123456" />
                            </div>
                            <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mt-3">
                        Create Account
                    </button>

                    <div class="text-center mt-3 small text-muted">
                        Already have an account?
                        <a asp-controller="Account" asp-action="Login" class="text-primary text-decoration-none fw-semibold">
                            Sign In
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<script>
    function toggleDoctorFields() {
        const isDoctor = document.getElementById('roleDoctor').checked;
        const doctorFields = document.getElementById('doctorFields');
        if (isDoctor) {
            doctorFields.classList.remove('d-none');
        } else {
            doctorFields.classList.add('d-none');
        }
    }

    function toggleOtherSpecialization() {
        const specSelect = document.getElementById('specializationSelect');
        const otherDiv = document.getElementById('otherSpecDiv');
        const otherInput = document.getElementById('otherSpecInput');

        if (specSelect.value === 'Other') {
            otherDiv.classList.remove('d-none');
            otherInput.focus();
        } else {
            otherDiv.classList.add('d-none');
            otherInput.value = '';
        }
    }
</script>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediConnect</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3 shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center fw-bold fs-4" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-heart-pulse-fill text-danger me-2"></i>
                    <span>Medi<span class="text-primary">Connect</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Home" asp-action="Doctors">
                                <i class="bi bi-hospital me-1"></i> Doctors
                            </a>
                        </li>

                        @if (User.IsInRole("Patient"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Appointments" asp-action="Book">
                                    <i class="bi bi-calendar-plus me-1"></i> Book Consultation
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Appointments" asp-action="PatientAppointments">
                                    <i class="bi bi-calendar2-check me-1"></i> My Appointments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-semibold" asp-controller="Appointments" asp-action="Profile">
                                    <i class="bi bi-heart-pulse me-1"></i> Health Profile
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Doctor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-success fw-semibold" asp-controller="Appointments" asp-action="DoctorSchedule">
                                    <i class="bi bi-clipboard2-pulse me-1"></i> My Schedule
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-info fw-semibold" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-semibold" asp-controller="Admin" asp-action="DoctorApprovals">
                                    <i class="bi bi-shield-check me-1"></i> Doctor Approvals
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="text-light me-2 small">
                                <i class="bi bi-person-circle text-primary me-1"></i>
                                <strong>@User.Identity.Name</strong>
                                <span class="badge bg-secondary ms-1">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</span>
                            </span>

                            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm px-3">
                                <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm px-3">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm px-3 fw-semibold">
                                <i class="bi bi-person-plus me-1"></i> Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show small py-2 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top py-3 text-muted text-center small mt-auto">
        <div class="container">
            &copy; 2026 <strong>MediConnect</strong> &mdash; Modern Clinic Management System. All rights reserved.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
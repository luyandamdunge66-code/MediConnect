@model IEnumerable<MediConnect.Models.Doctor>
@{
    ViewData["Title"] = "Our Medical Specialists";
}

<div class="container py-4">
    <!-- Header -->
    <div class="text-center mb-5">
        <h2 class="fw-bold text-dark mb-2">
            <i class="bi bi-hospital text-primary me-2"></i>Certified Medical Specialists
        </h2>
        <p class="text-muted col-md-7 mx-auto">
            Browse our verified clinic practitioners, read patient ratings, and schedule your consultation online.
        </p>
    </div>

    <!-- Doctor Cards Grid -->
    <div class="row g-4 justify-content-center">
        @if (!Model.Any())
        {
            <div class="col-md-6 text-center py-5">
                <div class="card border-0 shadow-sm p-5 text-muted">
                    <i class="bi bi-person-x fs-1 text-secondary mb-3"></i>
                    <h5>No verified doctors listed yet</h5>
                    <p class="small">Please check back shortly as our administrative team reviews medical applications.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var doctor in Model)
            {
                var reviews = doctor.Reviews ?? new List<MediConnect.Models.Review>();
                var hasReviews = reviews.Any();
                var avgRating = hasReviews ? reviews.Average(r => r.Rating) : 0;
                var reviewCount = reviews.Count;

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-3 p-4 text-center">

                        <!-- Doctor Photo or Vector Badge -->
                        <div class="mx-auto mb-3">
                            @if (!string.IsNullOrEmpty(doctor.ProfilePicture))
                            {
                                <img src="~/uploads/doctors/@doctor.ProfilePicture" class="rounded-circle border shadow-sm" style="width: 100px; height: 100px; object-fit: cover;" alt="Dr. @doctor.User?.FullName" />
                            }
                            else
                            {
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                                    <i class="bi bi-person-badge fs-1"></i>
                                </div>
                            }
                        </div>

                        <h5 class="fw-bold text-dark mb-1">Dr. @(doctor.User?.FullName ?? "Doctor")</h5>

                        <!-- Specialization -->
                        <div class="mb-2">
                            <span class="badge bg-light text-primary border px-3 py-1">
                                @doctor.Specialization
                            </span>
                        </div>

                        <!-- Live Star Rating Badge -->
                        <div class="mb-3">
                            @if (hasReviews)
                            {
                                <span class="badge bg-warning bg-opacity-25 text-dark border border-warning px-2 py-1 small">
                                    <i class="bi bi-star-fill text-warning me-1"></i>
                                    <strong>@avgRating.ToString("0.0")</strong> / 5.0 (@reviewCount @(reviewCount == 1 ? "review" : "reviews"))
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border small">
                                    <i class="bi bi-star me-1"></i>New Specialist (No reviews yet)
                                </span>
                            }
                        </div>

                        <p class="small text-muted mb-4">
                            <i class="bi bi-patch-check-fill text-success me-1"></i>
                            Practice Reg: <code>@doctor.LicenseNumber</code>
                        </p>

                        <!-- Action Button -->
                        <div class="mt-auto">
                            <a asp-controller="Appointments" asp-action="Book" class="btn btn-primary w-100 py-2 fw-semibold">
                                <i class="bi bi-calendar-plus me-1"></i> Book Consultation
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
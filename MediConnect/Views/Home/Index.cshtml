@{
    ViewData["Title"] = "MediConnect | Clinic Management";
}

<!-- Hero Banner -->
<div class="py-5 px-4 mb-5 bg-white border rounded-3 shadow-sm text-center">
    <div class="container py-3">
        <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle p-3 mb-3">
            <i class="bi bi-heart-pulse fs-1"></i>
        </div>
        <h1 class="display-5 fw-bold text-dark mb-2">MediConnect</h1>
        <p class="fs-5 text-muted col-md-8 mx-auto">
            A unified clinic management and appointment scheduling platform.
        </p>
        <p class="text-secondary small col-md-7 mx-auto mb-4">
            Connect patients with certified medical practitioners, manage real-time queues, and simplify clinic administration.
        </p>

        <div class="d-flex justify-content-center gap-3">
            <!-- This button now points directly to the booking page -->
            <a asp-controller="Appointments" asp-action="Book" class="btn btn-primary px-4 py-2 fw-semibold">
                <i class="bi bi-calendar-plus me-2"></i>Book Consultation
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-4 py-2 fw-semibold">
                <i class="bi bi-box-arrow-in-right me-2"></i>Staff Portal
            </a>
        </div>
    </div>
</div>

<!-- Portals Overview -->
<div class="row g-4">
    <!-- Patient Card -->
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-4 text-center">
            <div class="mx-auto mb-3 text-primary">
                <i class="bi bi-person-badge fs-1"></i>
            </div>
            <h5 class="fw-bold text-dark">Patient Portal</h5>
            <p class="text-muted small">
                Register, browse certified doctors by department, schedule consultations, and view medical appointment history.
            </p>
        </div>
    </div>

    <!-- Doctor Card -->
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-4 text-center">
            <div class="mx-auto mb-3 text-success">
                <i class="bi bi-clipboard2-pulse fs-1"></i>
            </div>
            <h5 class="fw-bold text-dark">Doctor Portal</h5>
            <p class="text-muted small">
                Access your consultation schedule, review patient records, manage bookings, and update appointment statuses.
            </p>
        </div>
    </div>

    <!-- Admin Card -->
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-4 text-center">
            <div class="mx-auto mb-3 text-dark">
                <i class="bi bi-shield-check fs-1"></i>
            </div>
            <h5 class="fw-bold text-dark">Administration</h5>
            <p class="text-muted small">
                Verify medical credentials, review doctor registrations, configure clinic departments, and monitor system analytics.
            </p>
        </div>
    </div>
</div>
@model IEnumerable<MediConnect.Models.Appointment>
@{
    ViewData["Title"] = "My Consultations";
}

<div class="container py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-calendar2-check text-primary me-2"></i>My Consultations
            </h2>
            <p class="text-muted small mb-0">Track your appointments, medical prescriptions, and review your doctors.</p>
        </div>
        <a asp-controller="Appointments" asp-action="Book" class="btn btn-primary btn-sm px-3 fw-semibold">
            <i class="bi bi-calendar-plus me-1"></i> Book New Appointment
        </a>
    </div>

    <!-- Consultations Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Doctor</th>
                            <th>Specialization</th>
                            <th>Date & Time</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Doctor Review</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary"></i>
                                    You have no scheduled appointments yet.
                                    <div class="mt-3">
                                        <a asp-controller="Appointments" asp-action="Book" class="btn btn-outline-primary btn-sm">
                                            Book your first appointment
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">
                                        <i class="bi bi-person-badge text-primary me-2"></i>
                                        Dr. @(item.Doctor?.User?.FullName ?? "Doctor")
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(item.Doctor?.Specialization ?? "General")
                                        </span>
                                    </td>
                                    <td>
                                        <div>@item.AppointmentDate.ToString("dd MMM yyyy")</div>
                                        <small class="text-muted">@DateTime.Today.Add(item.AppointmentTime).ToString("hh:mm tt")</small>
                                    </td>
                                    <td class="text-muted small">@item.Reason</td>
                                    <td>
                                        @if (item.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Pending</span>
                                        }
                                        else if (item.Status == "Confirmed")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Confirmed</span>
                                        }
                                        else if (item.Status == "Completed")
                                        {
                                            <span class="badge bg-primary"><i class="bi bi-check2-all me-1"></i>Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Cancelled</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (item.Status == "Completed")
                                        {
                                            @if (item.Review != null)
                                            {
                                                <!-- Already Reviewed Badge -->
                                                <span class="badge bg-warning bg-opacity-25 text-dark border border-warning px-2 py-1">
                                                    <i class="bi bi-star-fill text-warning me-1"></i>Rated @item.Review.Rating/5
                                                </span>
                                            }
                                            else
                                            {
                                                <!-- Review Trigger Button -->
                                                <button type="button" class="btn btn-outline-warning text-dark btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#reviewModal_@item.AppointmentId">
                                                    <i class="bi bi-star me-1"></i>Rate Doctor
                                                </button>

                                                <!-- Review Modal Popup -->
                                                <div class="modal fade" id="reviewModal_@item.AppointmentId" tabindex="-1" aria-hidden="true">
                                                    <div class="modal-dialog modal-dialog-centered">
                                                        <div class="modal-content border-0 shadow">
                                                            <div class="modal-header bg-light">
                                                                <h5 class="modal-title fw-bold">
                                                                    <i class="bi bi-star text-warning me-2"></i>Rate Dr. @(item.Doctor?.User?.FullName)
                                                                </h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <form asp-controller="Appointments" asp-action="LeaveReview" method="post">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="appointmentId" value="@item.AppointmentId" />

                                                                <div class="modal-body text-start">
                                                                    <div class="mb-3">
                                                                        <label class="form-label small fw-semibold">Consultation Rating:</label>
                                                                        <select name="rating" class="form-select" required>
                                                                            <option value="5">⭐⭐⭐⭐⭐ (5/5) - Excellent Care</option>
                                                                            <option value="4">⭐⭐⭐⭐ (4/5) - Very Good</option>
                                                                            <option value="3">⭐⭐⭐ (3/5) - Average</option>
                                                                            <option value="2">⭐⭐ (2/5) - Poor</option>
                                                                            <option value="1">⭐ (1/5) - Terrible</option>
                                                                        </select>
                                                                    </div>

                                                                    <div class="mb-3">
                                                                        <label class="form-label small fw-semibold">Your Feedback / Review (Optional):</label>
                                                                        <textarea name="comment" class="form-control" rows="3" placeholder="How was your consultation experience with the doctor?"></textarea>
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer bg-light">
                                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                                    <button type="submit" class="btn btn-warning btn-sm fw-semibold">
                                                                        Submit Review
                                                                    </button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Available after visit</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
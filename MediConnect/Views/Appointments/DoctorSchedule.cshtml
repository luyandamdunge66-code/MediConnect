@model IEnumerable<MediConnect.Models.Appointment>
@{
    ViewData["Title"] = "Doctor Schedule & Queue";
    var doctor = ViewBag.CurrentDoctor as MediConnect.Models.Doctor;
    var reviews = ViewBag.DoctorReviews as List<MediConnect.Models.Review> ?? new List<MediConnect.Models.Review>();
    var avgRating = reviews.Any() ? reviews.Average(r => r.Rating) : 0;
}

<div class="container py-3">
    
    <!-- Doctor Profile Header -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 p-4 bg-white">
        <div class="row align-items-center">
            <div class="col-md-auto text-center mb-3 mb-md-0">
                @if (doctor != null && !string.IsNullOrEmpty(doctor.ProfilePicture))
                {
                    <img src="~/uploads/doctors/@doctor.ProfilePicture" class="rounded-circle border shadow-sm" style="width: 90px; height: 90px; object-fit: cover;" alt="Doctor Profile" />
                }
                else
                {
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 90px; height: 90px;">
                        <i class="bi bi-person-badge fs-1"></i>
                    </div>
                }
            </div>
            <div class="col-md">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <h4 class="fw-bold text-dark mb-0">Dr. @(doctor?.User?.FullName ?? User.Identity?.Name)</h4>
                    @if (reviews.Any())
                    {
                        <span class="badge bg-warning bg-opacity-25 text-dark border border-warning px-2 py-1">
                            <i class="bi bi-star-fill text-warning me-1"></i><strong>@avgRating.ToString("0.0")</strong> / 5.0 (@reviews.Count @(reviews.Count == 1 ? "review" : "reviews"))
                        </span>
                    }
                </div>
                <p class="text-muted small mb-2">
                    <span class="badge bg-light text-primary border me-2">@(doctor?.Specialization ?? "Specialist")</span>
                    <span>Practice Reg: <code>@(doctor?.LicenseNumber ?? "N/A")</code></span>
                </p>

                <form asp-controller="Appointments" asp-action="UploadPhoto" method="post" enctype="multipart/form-data" class="row g-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <div class="col-auto">
                        <label class="form-label small fw-semibold text-secondary mb-0">Change Profile Photo:</label>
                    </div>
                    <div class="col-auto">
                        <input type="file" name="photoFile" class="form-control form-control-sm" accept="image/*" required />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-sm btn-outline-primary fw-semibold">
                            <i class="bi bi-upload me-1"></i> Upload Photo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Consultation Queue -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="bi bi-clipboard2-pulse text-success me-2"></i>My Consultation Queue
            </h4>
            <p class="text-muted small mb-0">Review patient medical alerts and record consultation notes.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 mb-5">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Patient & Health Alerts</th>
                            <th>Date & Time</th>
                            <th>Reported Symptoms</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-calendar2-minus fs-1 d-block mb-2 text-secondary"></i>
                                    No patient bookings in your schedule yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">
                                            <i class="bi bi-person text-primary me-1"></i>@(item.Patient?.User?.FullName ?? "Patient")
                                        </div>
                                        <!-- Real EMR Blood Group & Allergy Badges -->
                                        <div class="mt-1 d-flex flex-wrap gap-1">
                                            @if (!string.IsNullOrEmpty(item.Patient?.BloodGroup))
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle small">
                                                    <i class="bi bi-droplet-fill me-1"></i>Blood: @item.Patient.BloodGroup
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.Patient?.Allergies))
                                            {
                                                <span class="badge bg-warning bg-opacity-25 text-dark border border-warning small">
                                                    <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>Allergy: @item.Patient.Allergies
                                                </span>
                                            }
                                            @if (string.IsNullOrEmpty(item.Patient?.BloodGroup) && string.IsNullOrEmpty(item.Patient?.Allergies))
                                            {
                                                <small class="text-muted fst-italic">No health profile logged</small>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div>@item.AppointmentDate.ToString("dd MMM yyyy")</div>
                                        <small class="text-muted">@DateTime.Today.Add(item.AppointmentTime).ToString("hh:mm tt")</small>
                                    </td>
                                    <td class="text-muted small">@item.Reason</td>
                                    <td>
                                        @if (item.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Pending</span>
                                        }
                                        else if (item.Status == "Confirmed")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Confirmed</span>
                                        }
                                        else if (item.Status == "Completed")
                                        {
                                            <span class="badge bg-primary"><i class="bi bi-check2-all me-1"></i>Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Cancelled</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (item.Status == "Pending")
                                        {
                                            <div class="d-inline-flex gap-2">
                                                <form asp-controller="Appointments" asp-action="UpdateStatus" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="appointmentId" value="@item.AppointmentId" />
                                                    <input type="hidden" name="status" value="Confirmed" />
                                                    <button type="submit" class="btn btn-success btn-sm px-2">
                                                        <i class="bi bi-check-lg me-1"></i>Accept
                                                    </button>
                                                </form>

                                                <form asp-controller="Appointments" asp-action="UpdateStatus" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="appointmentId" value="@item.AppointmentId" />
                                                    <input type="hidden" name="status" value="Cancelled" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm px-2">
                                                        <i class="bi bi-x-lg me-1"></i>Decline
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else if (item.Status == "Confirmed")
                                        {
                                            <!-- Complete Consultation Button Triggering Modal -->
                                            <button type="button" class="btn btn-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#completeModal_@item.AppointmentId">
                                                <i class="bi bi-check2-all me-1"></i>Complete Visit
                                            </button>

                                            <!-- Modal to write Diagnosis & Prescription -->
                                            <div class="modal fade text-start" id="completeModal_@item.AppointmentId" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content border-0 shadow">
                                                        <div class="modal-header bg-light">
                                                            <h5 class="modal-title fw-bold">
                                                                <i class="bi bi-clipboard-pulse text-primary me-2"></i>Complete Consultation
                                                            </h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <form asp-controller="Appointments" asp-action="CompleteConsultation" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="appointmentId" value="@item.AppointmentId" />

                                                            <div class="modal-body">
                                                                <div class="mb-3">
                                                                    <label class="form-label small fw-semibold">Patient:</label>
                                                                    <input type="text" class="form-control form-control-sm bg-light" value="@(item.Patient?.User?.FullName)" readonly />
                                                                </div>

                                                                <div class="mb-3">
                                                                    <label class="form-label small fw-semibold">Medical Diagnosis:</label>
                                                                    <input type="text" name="diagnosis" class="form-control" placeholder="e.g. Acute Migraine / Hypertension" required />
                                                                </div>

                                                                <div class="mb-3">
                                                                    <label class="form-label small fw-semibold">Prescription & Advice:</label>
                                                                    <textarea name="doctorNotes" class="form-control" rows="3" placeholder="Medications, dosage, rest period, or follow-up instructions..." required></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer bg-light">
                                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-success btn-sm fw-semibold">
                                                                    Save & Complete
                                                                </button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else if (item.Status == "Completed")
                                        {
                                            <!-- Doctor Print / View Note Button -->
                                            <button type="button" class="btn btn-outline-primary btn-sm px-2" data-bs-toggle="modal" data-bs-target="#printModal_@item.AppointmentId">
                                                <i class="bi bi-printer me-1"></i>Print Slip
                                            </button>

                                            <!-- Official Medical Prescription Slip Modal -->
                                            <div class="modal fade text-start" id="printModal_@item.AppointmentId" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                                    <div class="modal-content border-0 shadow">
                                                        <div class="modal-body p-4 p-md-5" id="slip_@item.AppointmentId">
                                                            <!-- Clinic Letterhead -->
                                                            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                                                                <div>
                                                                    <h3 class="fw-bold text-primary mb-0">🏥 MediConnect Clinic</h3>
                                                                    <small class="text-muted">Official Medical Consultation Slip</small>
                                                                </div>
                                                                <div class="text-end">
                                                                    <small class="text-muted d-block">Date: @item.AppointmentDate.ToString("dd MMMM yyyy")</small>
                                                                    <span class="badge bg-success">Consultation Completed</span>
                                                                </div>
                                                            </div>

                                                            <!-- Doctor & Patient Details -->
                                                            <div class="row g-3 mb-4">
                                                                <div class="col-6">
                                                                    <h6 class="fw-bold text-secondary small text-uppercase mb-1">Attending Specialist:</h6>
                                                                    <p class="mb-0 fw-bold">Dr. @(doctor?.User?.FullName ?? User.Identity?.Name)</p>
                                                                    <small class="text-muted">@(doctor?.Specialization) • Reg: @(doctor?.LicenseNumber)</small>
                                                                </div>
                                                                <div class="col-6">
                                                                    <h6 class="fw-bold text-secondary small text-uppercase mb-1">Patient Details:</h6>
                                                                    <p class="mb-0 fw-bold">@(item.Patient?.User?.FullName)</p>
                                                                    <small class="text-muted">
                                                                        Blood: @(item.Patient?.BloodGroup ?? "N/A") | 
                                                                        Allergies: @(item.Patient?.Allergies ?? "None recorded")
                                                                    </small>
                                                                </div>
                                                            </div>

                                                            <!-- Clinical Diagnosis -->
                                                            <div class="mb-4 p-3 bg-light rounded-3 border">
                                                                <h6 class="fw-bold text-primary small text-uppercase mb-1">Clinical Diagnosis:</h6>
                                                                <p class="mb-0 fs-5 fw-semibold text-dark">@(item.Diagnosis ?? "General Medical Examination")</p>
                                                            </div>

                                                            <!-- Prescription & Treatment Notes -->
                                                            <div class="mb-4">
                                                                <h6 class="fw-bold text-secondary small text-uppercase mb-1">Rx / Prescription & Medical Advice:</h6>
                                                                <div class="p-3 border rounded-3 bg-white" style="min-height: 100px; white-space: pre-line;">
                                                                    @(item.DoctorNotes ?? "No additional medications prescribed.")
                                                                </div>
                                                            </div>

                                                            <!-- Signature Line -->
                                                            <div class="pt-4 border-top d-flex justify-content-between align-items-end mt-4">
                                                                <small class="text-muted">Computer-generated medical slip &bull; MediConnect EMR</small>
                                                                <div class="text-center" style="width: 200px;">
                                                                    <div class="border-bottom pb-2 fw-semibold">Dr. @(doctor?.User?.FullName ?? User.Identity?.Name)</div>
                                                                    <small class="text-muted">Authorized Signature</small>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer bg-light">
                                                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                                                            <button type="button" class="btn btn-primary btn-sm px-3" onclick="window.print()">
                                                                <i class="bi bi-printer me-1"></i> Print Slip
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Patient Reviews Section -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-chat-heart text-warning me-2"></i>Patient Reviews & Feedback (@reviews.Count)
            </h5>
            @if (reviews.Any())
            {
                <span class="badge bg-warning bg-opacity-25 text-dark border border-warning">
                    Average: ★ @avgRating.ToString("0.0") / 5.0
                </span>
            }
        </div>
        <div class="card-body p-4 pt-0">
            @if (!reviews.Any())
            {
                <div class="text-center py-4 text-muted small">
                    <i class="bi bi-chat-square-dots fs-3 d-block mb-2 text-secondary"></i>
                    No patient reviews received yet. Reviews will appear here once patients rate their completed visits.
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var review in reviews)
                    {
                        <div class="list-group-item px-0 py-3">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <div>
                                    <strong class="text-dark">@(review.Patient?.User?.FullName ?? "Verified Patient")</strong>
                                    <span class="text-warning ms-2">
                                        @for (int i = 1; i <= review.Rating; i++)
                                        {
                                            <span>★</span>
                                        }
                                    </span>
                                    <span class="badge bg-light text-muted border ms-1">@review.Rating/5</span>
                                </div>
                                <small class="text-muted">@review.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</small>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <p class="text-secondary mb-0 small fst-italic ps-2 border-start border-warning border-3 mt-2">
                                    "@review.Comment"
                                </p>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

</div>